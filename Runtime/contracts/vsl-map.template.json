      { "selector": "[data-place=shop]", "vslActionId": "action-open-shop" },
      { "selector": "[data-place=guild]", "vslActionId": "action-open-guild" },
      { "selector": "[data-place=museum]", "vslActionId": "action-open-museum" }
    ], "dataBindings": [
      { "selector": "[data-bind=day]", "vslDataPath": "run.day" },
      { "selector": "[data-bind=cash]", "vslDataPath": "player.cash" },
      { "selector": "#market-indices", "vslDataPath": "market.indices" }
    ] },
    { "runtimeSceneId": "tavern", "vslSceneId": "scene-tavern", "actions": [
