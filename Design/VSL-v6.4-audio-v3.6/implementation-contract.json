  "canvas": {
    "width": 1536,
    "height": 1024,
    "scaleMode": "fit",
    "anchor": "center",
    "letterbox": true,
    "letterboxColor": "#000000",
    "coordinateUnit": "percent",
    "scaleWholeCanvas": true,
    "responsiveLayout": false,
    "sceneContentMapping": "contain-content-rect"
  },
  "assetPolicy": {
    "referenceMockupRuntimeUse": "temporary-only",
    "onMissingAsset": "show-error-placeholder",
    "allowCssFallback": false,
    "failClosed": true,
    "fallbackColor": "#2a2118",
    "defaultBackgroundFit": "contain"
  },
  "renderer": {
    "layers": [
      "background-layer",
      "content-layer",
      "ui-layer",
      "popup-layer",
      "toast-layer"
    ],
    "popupMount": "project-canvas",
    "readFlow": true,
    "readLayout": true,
    "readContracts": true,
    "sceneTransformPolicy": {
      "enabled": true,
      "defaultScale": 1.0,
      "defaultOffsetXPercent": 0.0,
      "defaultOffsetYPercent": 0.0,
      "anchor": "center",
      "appliesTo": "background-and-scene-ui",
      "allowPerSceneOverride": true,
      "note": "현재는 scale=1.0. 이후 씬별 보정은 배경과 해당 씬 UI를 함께 변환한다."
    },
    "failureFeedbackPolicy": {
      "sceneFailureSlots": false,
      "regularActionFailureUiStateRef": "popup-global-failure",
      "regularActionFailureMessageDataRef": "ui.lastMessage",
      "successAndInfoUiStateRef": "toast-global",
      "runEndingPresentation": "result-state",
      "runEndingUiStateRefs": [
        "state-result-bankruptcy"
      ],
      "popupMountLayer": "popup-layer",
      "toastMountLayer": "toast-layer",
      "rule": "일반 행동 실패는 전역 팝업, 성공·정보는 토스트, 여정 종료 실패는 결과 상태로 표시한다."
    }
  },
